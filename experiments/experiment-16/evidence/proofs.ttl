    prov:wasGeneratedBy adcs:SA-REQ-002 ;
    prov:generatedAtTime "2026-04-01T10:01:00Z"^^xsd:dateTime .

adcs:SA-REQ-002 a rtm:SymbolicAnalysis ;
    prov:wasAssociatedWith adcs:SymPyEngine .

